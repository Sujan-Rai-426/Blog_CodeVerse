{
    "version": 3,
    "builds": [
        {
            "src": "manage.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "50mb"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "manage.py"
        }
    ],
    "build": {
        "commands": [
            "pip install -r requirements.txt",
            "python manage.py migrate",
            "python manage.py collectstatic --noinput"
        ]
    }
}
